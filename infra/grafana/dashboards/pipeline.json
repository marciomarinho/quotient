{
  "uid": "quotient-pipeline",
  "title": "Quotient — Pipeline",
  "tags": ["quotient"],
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Kafka consumer lag (records)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application, client_id) (kafka_consumer_fetch_manager_records_lag)",
          "legendFormat": "{{application}} {{client_id}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Records consumed / s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (application) (rate(kafka_consumer_fetch_manager_records_consumed_total[1m]))",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Rating throughput — charges produced / s",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kafka_producer_record_send_total{application=\"rating-engine\"}[1m]))",
          "legendFormat": "charges/s"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Trace-derived request latency p99 (from span metrics)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(traces_spanmetrics_latency_bucket[5m])))",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ]
}
