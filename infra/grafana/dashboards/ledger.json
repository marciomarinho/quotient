{
  "uid": "quotient-ledger",
  "title": "Quotient — Ledger",
  "tags": ["quotient"],
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Ledger postings / s (per tenant, per outcome)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tenant, outcome) (rate(quotient_ledger_postings_total[1m]))",
          "legendFormat": "{{tenant}} {{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total postings (posted)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(quotient_ledger_postings_total{outcome=\"posted\"})",
          "legendFormat": "posted"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Duplicate posts avoided",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(quotient_ledger_postings_total{outcome=\"duplicate\"})",
          "legendFormat": "duplicates"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Posting latency p99 (s)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"ledger-service\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    }
  ]
}
