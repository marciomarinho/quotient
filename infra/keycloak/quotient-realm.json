{
  "realm": "quotient",
  "enabled": true,
  "displayName": "Quotient",
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "tenant-admin", "description": "Manage invoices and API keys for own tenant" },
      { "name": "tenant-viewer", "description": "Read-only access to own tenant's ledger" },
      { "name": "platform-operator", "description": "Cross-tenant operator (demo script only)" }
    ]
  },
  "clients": [
    {
      "clientId": "quotient-ledger",
      "name": "Ledger Service (resource server)",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:8086/*"],
      "webOrigins": ["*"],
      "secret": "ledger-secret",
      "attributes": { "access.token.lifespan": "300" }
    },
    {
      "clientId": "tenant-acme",
      "name": "Tenant Acme (client_credentials)",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "secret": "acme-secret",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "11111111-1111-1111-1111-111111111111",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tenant-globex",
      "name": "Tenant Globex (client_credentials)",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "secret": "globex-secret",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "22222222-2222-2222-2222-222222222222",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tenant-initech",
      "name": "Tenant Initech (client_credentials)",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "secret": "initech-secret",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "33333333-3333-3333-3333-333333333333",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "quotient-demo-operator",
      "name": "Demo Operator (cross-tenant, client_credentials)",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "secret": "operator-secret"
    }
  ],
  "users": [
    {
      "username": "service-account-tenant-acme",
      "enabled": true,
      "serviceAccountClientId": "tenant-acme",
      "realmRoles": ["tenant-admin", "tenant-viewer"]
    },
    {
      "username": "service-account-tenant-globex",
      "enabled": true,
      "serviceAccountClientId": "tenant-globex",
      "realmRoles": ["tenant-admin", "tenant-viewer"]
    },
    {
      "username": "service-account-tenant-initech",
      "enabled": true,
      "serviceAccountClientId": "tenant-initech",
      "realmRoles": ["tenant-admin", "tenant-viewer"]
    },
    {
      "username": "service-account-quotient-demo-operator",
      "enabled": true,
      "serviceAccountClientId": "quotient-demo-operator",
      "realmRoles": ["platform-operator"]
    }
  ]
}
